{
    "swagger": "2.0",
    "info": {
        "description": "Hei Gin 后台管理系统 API 文档",
        "title": "Hei Gin API",
        "termsOfService": "https://github.com/jiangbyte/hei-gin",
        "contact": {
            "name": "Charlie",
            "url": "https://github.com/jiangbyte"
        },
        "license": {
            "name": "MIT",
            "url": "https://github.com/jiangbyte/hei-gin/blob/main/LICENSE"
        },
        "version": "1.0.0"
    },
    "host": "localhost:18885",
    "basePath": "/api/v1",
    "paths": {
        "/api/v1/sys/banner/create": {
            "post": {
                "description": "创建一条新的横幅记录",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "横幅管理"
                ],
                "summary": "添加横幅",
                "parameters": [
                    {
                        "description": "横幅数据",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/banner.BannerVO"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "创建成功",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/sys/banner/detail": {
            "get": {
                "description": "根据 ID 获取横幅详情",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "横幅管理"
                ],
                "summary": "横幅详情",
                "parameters": [
                    {
                        "type": "string",
                        "description": "横幅 ID",
                        "name": "id",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/sys/banner/modify": {
            "post": {
                "description": "修改已有的横幅记录",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "横幅管理"
                ],
                "summary": "编辑横幅",
                "parameters": [
                    {
                        "description": "横幅数据（id 必填）",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/banner.BannerVO"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "修改成功",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/sys/banner/page": {
            "get": {
                "description": "获取横幅分页列表",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "横幅管理"
                ],
                "summary": "横幅分页",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "页码（默认 1）",
                        "name": "current",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "每页条数（默认 10，最大 100）",
                        "name": "size",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "分页数据",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/sys/banner/remove": {
            "post": {
                "description": "批量删除横幅记录",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "横幅管理"
                ],
                "summary": "删除横幅",
                "parameters": [
                    {
                        "description": "待删除 ID 列表",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/utils.IdsParam"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "删除成功",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "banner.BannerVO": {
            "type": "object",
            "properties": {
                "category": {
                    "type": "string"
                },
                "click_count": {
                    "type": "integer"
                },
                "created_at": {
                    "type": "string"
                },
                "created_by": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "image": {
                    "type": "string"
                },
                "link_type": {
                    "type": "string"
                },
                "position": {
                    "type": "string"
                },
                "sort_code": {
                    "type": "integer"
                },
                "summary": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                },
                "updated_by": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                },
                "view_count": {
                    "type": "integer"
                }
            }
        },
        "utils.IdsParam": {
            "type": "object",
            "properties": {
                "ids": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Bearer token authentication",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}