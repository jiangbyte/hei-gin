{{if and $.HasTree (eq (index $field "name") (index $.Plan "tree_parent_field"))}}
            {{"{{"}} displayValue(state.detail.{{index $field "name"}}_name || state.detail.{{index $field "name"}}) {{"}}" }}
{{else if hasDictCode $field}}
            <NTag :color="createTagColor(dictTypeColor('{{index $field "dict_code"}}', state.detail.{{index $field "name"}}))" :bordered="false">
              {{"{{"}} dictTypeData('{{index $field "dict_code"}}', state.detail.{{index $field "name"}}) || displayValue(state.detail.{{index $field "name"}}) {{"}}" }}
            </NTag>
{{else if eq (index $field "value_type") "datetime"}}
            {{"{{"}} formatDateTime(state.detail.{{index $field "name"}}) {{"}}" }}
{{else if eq (index $field "widget") "richtext"}}
            <RichTextPreview :value="state.detail.{{index $field "name"}}" />
{{else if eq (index $field "widget") "markdown"}}
            <MdPreview :value="state.detail.{{index $field "name"}}" />
{{else if eq (index $field "widget") "code"}}
            <MonacoPreview :value="state.detail.{{index $field "name"}}" language="{{index $field "code_language"}}" height="240px" />
{{else if eq (index $field "widget") "icon"}}
            <NFlex v-if="state.detail.{{index $field "name"}}" align="center" :size="8">
              <NovaIcon :icon="String(state.detail.{{index $field "name"}})" :size="18" />
              {{"{{"}} displayValue(state.detail.{{index $field "name"}}) {{"}}" }}
            </NFlex>
            <span v-else>-</span>
{{else if (index $field "is_json")}}
            <NCode :code="formatJsonValue(state.detail.{{index $field "name"}})" language="json" word-wrap />
{{else}}
            {{"{{"}} displayValue(state.detail.{{index $field "name"}}) {{"}}" }}
{{end}}
          </NDescriptionsItem>
{{end}}
          <NDescriptionsItem label="创建时间">{{"{{"}} formatDateTime(state.detail.created_at) {{"}}" }}</NDescriptionsItem>
          <NDescriptionsItem label="创建人">{{"{{"}} displayValue(state.detail.created_name || state.detail.created_by) {{"}}" }}</NDescriptionsItem>
