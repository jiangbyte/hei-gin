  state.treeLoading = true
  try {
    const response = await {{.APIExportName}}.tree({{if eq (deref (index .Plan "gen_type")) "LEFT_TREE_TABLE"}}{ keyword: state.treeKeyword || undefined }{{end}})
    state.treeRows = response.data ?? []
  } finally {
    state.treeLoading = false
  }
}

