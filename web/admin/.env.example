# Admin Vite env example
# 开发默认 VITE_API_URL 留空，走同源 /api + Vite proxy（Cookie 会话）。
# 仅在确需跨域直连后端时再设置 VITE_API_URL，并保证后端 CORS + SameSite=None/Secure。
VITE_API_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_PORT=5173
# dynamic：侧栏/路由来自 /sys/resources/current（按授权收束）
# static：使用 src/router/routes.static.ts（不按 resource_ids 过滤菜单）
VITE_ROUTE_LOAD_MODE="dynamic"
VITE_HOME_PATH="/dashboard"
